# Docker Runner Autoscaler - runner configuration (used by docker-compose.yml)

# Fine-grained PAT: Organization permissions -> Self-hosted runners: Read and write
GH_PAT=

# org | repo
RUNNER_SCOPE=org
# RUNNER_SCOPE=org
ORG_NAME=
# RUNNER_SCOPE=repo, e.g. https://github.com/owner/repo
REPO_URL=

RUNNER_GROUP=Default
RUNNER_NAME_PREFIX=dd
RUNNER_LABELS=linux,docker,x64
